+  tree2.root()->Add(MakeTextureLayer(0));
+  auto damage = DiffLayerTree(tree2, tree1);
+  EXPECT_EQ(damage.frame_damage, DlIRect::MakeLTRB(0, 0, 100, 100));
+}
