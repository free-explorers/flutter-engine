   // Called on raster thread.
   virtual void OnTextureUnregistered() = 0;
 
+  // Identifies the frame the texture presents, for a texture that keeps
+  // presenting the same frame until |MarkNewFrameAvailable| is called. Two
+  // equal identifiers mean the same content: a texture layer showing it is
+  // then left out of the frame damage. Identifiers are never shared between
+  // textures, so a texture registered again under the same id does not look
+  // unchanged.
+  //
+  // Returns std::nullopt, the default, for a texture that may present a new
+  // frame on any paint: the whole area of its layers is damaged on every
+  // frame.
+  //
+  // Called on raster thread.
+  virtual std::optional<uint64_t> GetFrameId() const { return std::nullopt; }
+
   int64_t Id() { return id_; }
 
+ protected:
+  // Returns a frame identifier that no texture has used yet, for textures
+  // implementing |GetFrameId|.
+  static uint64_t NextFrameId();
+
  private:
   int64_t id_;
   FML_DISALLOW_COPY_AND_ASSIGN(Texture);
