@@ -254,6 +261,44 @@ PaintRegion DiffContext::GetOldLayerPaintRegion(const Layer* layer) const {
   }
 }
 
+std::optional<uint64_t> DiffContext::GetTextureFrameId(
+    int64_t texture_id) const {
+  if (!texture_registry_) {
+    return std::nullopt;
+  }
+  auto texture = texture_registry_->GetTexture(texture_id);
+  if (!texture) {
+    return std::nullopt;
+  }
+  return texture->GetFrameId();
+}
+
+void DiffContext::SetLayerTextureFrame(const Layer* layer, int64_t texture_id) {
+  if (!this_frame_texture_frame_map_) {
+    return;
+  }
+  auto frame_id = GetTextureFrameId(texture_id);
+  if (frame_id.has_value()) {
+    (*this_frame_texture_frame_map_)[layer->unique_id()] = frame_id.value();
+  }
+}
+
+bool DiffContext::IsOldLayerTextureFrameCurrent(const Layer* layer,
+                                                int64_t texture_id) const {
+  if (!last_frame_texture_frame_map_) {
+    return false;
+  }
+  auto frame_id = GetTextureFrameId(texture_id);
+  if (!frame_id.has_value()) {
+    return false;
+  }
+  auto i = last_frame_texture_frame_map_->find(layer->unique_id());
+  // Frame identifiers are unique across textures: an old layer that painted
+  // another texture never matches.
+  return i != last_frame_texture_frame_map_->end() &&
+         i->second == frame_id.value();
+}
