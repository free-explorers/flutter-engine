+static std::shared_ptr<TextureLayer> MakeTextureLayer(
+    int64_t texture_id,
+    const DlPoint& offset = DlPoint()) {
+  return std::make_shared<TextureLayer>(offset, DlSize(100, 100), texture_id,
+                                        false, DlImageSampling::kLinear);
+}
+
+TEST_F(TextureLayerDiffTest, TextureWithoutFrameIdsIsAlwaysDamaged) {
+  auto texture = std::make_shared<MockTexture>(0);
+  texture_registry()->RegisterTexture(texture);
+
+  MockLayerTree tree1;
+  tree1.root()->Add(MakeTextureLayer(0));
+  DiffLayerTree(tree1, MockLayerTree());
+
+  MockLayerTree tree2;
+  tree2.root()->Add(MakeTextureLayer(0));
+  auto damage = DiffLayerTree(tree2, tree1);
+  EXPECT_EQ(damage.frame_damage, DlIRect::MakeLTRB(0, 0, 100, 100));
+}
+
+TEST_F(TextureLayerDiffTest, TextureWithoutNewFrameIsNotDamaged) {
+  auto texture = std::make_shared<MockTexture>(0);
+  texture->IdentifyFrames();
+  texture_registry()->RegisterTexture(texture);
+
+  MockLayerTree tree1;
+  tree1.root()->Add(MakeTextureLayer(0));
+  auto damage = DiffLayerTree(tree1, MockLayerTree());
+  EXPECT_EQ(damage.frame_damage, DlIRect::MakeLTRB(0, 0, 100, 100));
+
+  MockLayerTree tree2;
+  tree2.root()->Add(MakeTextureLayer(0));
+  damage = DiffLayerTree(tree2, tree1);
+  EXPECT_TRUE(damage.frame_damage.IsEmpty());
+
+  texture->MarkNewFrameAvailable();
+  MockLayerTree tree3;
+  tree3.root()->Add(MakeTextureLayer(0));
+  damage = DiffLayerTree(tree3, tree2);
+  EXPECT_EQ(damage.frame_damage, DlIRect::MakeLTRB(0, 0, 100, 100));
+}
+
+TEST_F(TextureLayerDiffTest, RetainedTextureWithoutNewFrameIsNotDamaged) {
+  auto texture = std::make_shared<MockTexture>(0);
+  texture->IdentifyFrames();
+  texture_registry()->RegisterTexture(texture);
+
+  MockLayerTree tree1;
+  auto container = std::make_shared<ContainerLayer>();
+  tree1.root()->Add(container);
+  container->Add(MakeTextureLayer(0));
+  DiffLayerTree(tree1, MockLayerTree());
+
+  MockLayerTree tree2;
+  tree2.root()->Add(container);  // retained layer
+  auto damage = DiffLayerTree(tree2, tree1);
+  EXPECT_TRUE(damage.frame_damage.IsEmpty());
+
+  texture->MarkNewFrameAvailable();
+  MockLayerTree tree3;
+  tree3.root()->Add(container);  // retained layer
+  damage = DiffLayerTree(tree3, tree2);
+  EXPECT_EQ(damage.frame_damage, DlIRect::MakeLTRB(0, 0, 100, 100));
+}
+
+TEST_F(TextureLayerDiffTest, MovedTextureIsDamaged) {
+  auto texture = std::make_shared<MockTexture>(0);
+  texture->IdentifyFrames();
+  texture_registry()->RegisterTexture(texture);
+
+  MockLayerTree tree1;
+  tree1.root()->Add(MakeTextureLayer(0));
+  DiffLayerTree(tree1, MockLayerTree());
+
+  MockLayerTree tree2;
+  tree2.root()->Add(MakeTextureLayer(0, DlPoint(50, 0)));
+  auto damage = DiffLayerTree(tree2, tree1);
+  EXPECT_EQ(damage.frame_damage, DlIRect::MakeLTRB(0, 0, 150, 100));
+}
+
+TEST_F(TextureLayerDiffTest, ReplacedTextureIsDamaged) {
+  auto texture = std::make_shared<MockTexture>(0);
+  texture->IdentifyFrames();
+  texture_registry()->RegisterTexture(texture);
+
+  MockLayerTree tree1;
+  tree1.root()->Add(MakeTextureLayer(0));
