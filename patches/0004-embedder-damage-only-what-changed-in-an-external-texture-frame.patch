+#ifndef FLUTTER_SHELL_PLATFORM_EMBEDDER_EMBEDDER_EXTERNAL_TEXTURE_FRAMES_H_
+#define FLUTTER_SHELL_PLATFORM_EMBEDDER_EMBEDDER_EXTERNAL_TEXTURE_FRAMES_H_
+
+#include <cstdint>
+#include <deque>
+#include <map>
+#include <mutex>
+#include <optional>
+
+#include "flutter/common/graphics/texture.h"
+#include "flutter/fml/macros.h"
+
+namespace flutter {
+
+//------------------------------------------------------------------------------
+/// The frames the embedder marks available on its external textures, with
+/// their damage, from the platform thread where a frame is marked to the
+/// raster thread where the texture takes it.
+///
+/// Every frame marked available reaches the texture as exactly one
+/// |Texture::MarkNewFrameAvailable|, in the same order, so each call takes
+/// the damage of the oldest frame not taken yet.
+///
+class EmbedderExternalTextureFrames {
+ public:
+  EmbedderExternalTextureFrames();
+
+  ~EmbedderExternalTextureFrames();
+
+  //----------------------------------------------------------------------------
+  /// @brief      Starts recording the frames of texture |texture_id|.
+  ///
+  ///             Called on the platform thread, when the texture is
+  ///             registered.
+  ///
+  void Register(int64_t texture_id);
+
+  //----------------------------------------------------------------------------
+  /// @brief      Records a new frame of texture |texture_id|, with the part of
+  ///             it that changed since the previous frame, or std::nullopt
+  ///             when that is not known. Frames of a texture that is not
+  ///             registered are not recorded: no texture would take them.
+  ///
+  ///             Called on the platform thread.
+  ///
+  void MarkFrameAvailable(int64_t texture_id,
+                          std::optional<Texture::Damage> damage);
+
+  //----------------------------------------------------------------------------
+  /// @brief      Takes the damage of the oldest frame of texture |texture_id|
+  ///             not taken yet, or std::nullopt when it is not known.
+  ///
+  ///             Called on the raster thread.
+  ///
+  std::optional<Texture::Damage> TakeFrame(int64_t texture_id);
+
+  //----------------------------------------------------------------------------
+  /// @brief      Drops the frames of texture |texture_id| not taken yet, and
+  ///             stops recording its frames.
+  ///
+  ///             Called on the platform thread, when the texture is
+  ///             unregistered.
+  ///
+  void Forget(int64_t texture_id);
+
+  //----------------------------------------------------------------------------
+  /// The frames one texture presented, for |Texture::GetFrameId| and
+  /// |Texture::GetDamageSince|.
+  ///
+  /// Only used on the raster thread.
+  ///
+  class History {
+   public:
+    History();
+
+    //--------------------------------------------------------------------------
+    /// @brief      The frame the texture presents.
+    ///
+    uint64_t frame_id() const { return frame_id_; }
+
+    //--------------------------------------------------------------------------
+    /// @brief      Moves on to a new frame, with the part of it that changed
+    ///             since the previous one, or std::nullopt when that is not
+    ///             known.
+    ///
+    void AddFrame(std::optional<Texture::Damage> damage);
+
+    //--------------------------------------------------------------------------
+    /// @brief      The damage since the texture presented frame |frame_id|,
+    ///             or std::nullopt when that is not known: |frame_id| is too
+    ///             old, the damage of a frame since was not known, or the
+    ///             frame size changed.
+    ///
+    std::optional<Texture::Damage> DamageSince(uint64_t frame_id) const;
+
+   private:
+    struct Frame {
+      uint64_t frame_id;
+      // The damage since the frame before it.
+      std::optional<Texture::Damage> damage;
+    };
+
+    uint64_t frame_id_;
+    // The frame before the oldest of |frames_|.
+    uint64_t oldest_frame_id_;
+    std::deque<Frame> frames_;
+  };
+
+ private:
+  // Frames marked available beyond this many, and not taken yet, are only
+  // known to be damaged as a whole.
+  static constexpr size_t kMaxPendingFrames = 16;
+
+  struct Pending {
+    std::deque<std::optional<Texture::Damage>> frames;
+    // Frames dropped from the front of |frames|.
+    size_t dropped = 0;
+  };
+
+  std::mutex mutex_;
+  std::map<int64_t, Pending> pending_;
+
+  FML_DISALLOW_COPY_AND_ASSIGN(EmbedderExternalTextureFrames);
+};
+
+}  // namespace flutter
+
+#endif  // FLUTTER_SHELL_PLATFORM_EMBEDDER_EMBEDDER_EXTERNAL_TEXTURE_FRAMES_H_
