@@ -299,6 +316,23 @@ bool DiffContext::IsOldLayerTextureFrameCurrent(const Layer* layer,
          i->second == frame_id.value();
 }
 
+std::optional<Texture::Damage> DiffContext::GetOldLayerTextureDamage(
+    const Layer* layer,
+    int64_t texture_id) const {
+  if (!last_frame_texture_frame_map_ || !texture_registry_) {
+    return std::nullopt;
+  }
+  auto i = last_frame_texture_frame_map_->find(layer->unique_id());
+  if (i == last_frame_texture_frame_map_->end()) {
+    return std::nullopt;
+  }
+  auto texture = texture_registry_->GetTexture(texture_id);
+  if (!texture) {
+    return std::nullopt;
+  }
+  return texture->GetDamageSince(i->second);
+}
