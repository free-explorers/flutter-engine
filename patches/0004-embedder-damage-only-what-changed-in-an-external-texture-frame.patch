diff --git a/engine/src/flutter/shell/platform/embedder/embedder_external_texture_frames.cc b/engine/src/flutter/shell/platform/embedder/embedder_external_texture_frames.cc
new file mode 100644
index 0000000000..5c12ff837d
--- /dev/null
+++ b/engine/src/flutter/shell/platform/embedder/embedder_external_texture_frames.cc
@@ -0,0 +1,111 @@
+// Copyright 2013 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/shell/platform/embedder/embedder_external_texture_frames.h"
+
+#include <utility>
+
+namespace flutter {
+
+namespace {
+
+// Frames whose damage a texture keeps, to answer for layer trees painted that
+// many frames ago at most.
+constexpr size_t kMaxHistoryFrames = 8;
+
+}  // namespace
+
+EmbedderExternalTextureFrames::EmbedderExternalTextureFrames() = default;
+
+EmbedderExternalTextureFrames::~EmbedderExternalTextureFrames() = default;
+
+void EmbedderExternalTextureFrames::Register(int64_t texture_id) {
+  std::scoped_lock lock(mutex_);
+  pending_[texture_id] = Pending();
+}
+
+void EmbedderExternalTextureFrames::MarkFrameAvailable(
+    int64_t texture_id,
+    std::optional<Texture::Damage> damage) {
+  std::scoped_lock lock(mutex_);
+  auto found = pending_.find(texture_id);
+  if (found == pending_.end()) {
+    return;
+  }
+  auto& pending = found->second;
+  pending.frames.push_back(damage);
+  if (pending.frames.size() > kMaxPendingFrames) {
+    pending.frames.pop_front();
+    pending.dropped++;
+  }
+}
+
+std::optional<Texture::Damage> EmbedderExternalTextureFrames::TakeFrame(
+    int64_t texture_id) {
+  std::scoped_lock lock(mutex_);
+  auto found = pending_.find(texture_id);
+  if (found == pending_.end()) {
+    return std::nullopt;
+  }
+  auto& pending = found->second;
+  std::optional<Texture::Damage> damage;
+  if (pending.dropped > 0) {
+    pending.dropped--;
+  } else if (!pending.frames.empty()) {
+    damage = pending.frames.front();
+    pending.frames.pop_front();
+  }
+  return damage;
+}
+
+void EmbedderExternalTextureFrames::Forget(int64_t texture_id) {
+  std::scoped_lock lock(mutex_);
+  pending_.erase(texture_id);
+}
+
+EmbedderExternalTextureFrames::History::History()
+    : frame_id_(Texture::NextFrameId()), oldest_frame_id_(frame_id_) {}
+
+void EmbedderExternalTextureFrames::History::AddFrame(
+    std::optional<Texture::Damage> damage) {
+  frame_id_ = Texture::NextFrameId();
+  frames_.push_back({frame_id_, damage});
+  if (frames_.size() > kMaxHistoryFrames) {
+    oldest_frame_id_ = frames_.front().frame_id;
+    frames_.pop_front();
+  }
+}
+
+std::optional<Texture::Damage>
+EmbedderExternalTextureFrames::History::DamageSince(uint64_t frame_id) const {
+  if (frames_.empty()) {
+    return std::nullopt;
+  }
+  auto frame = frames_.begin();
+  if (frame_id != oldest_frame_id_) {
+    while (frame != frames_.end() && frame->frame_id != frame_id) {
+      ++frame;
+    }
+    if (frame == frames_.end()) {
+      return std::nullopt;
+    }
+    // The damage of the frames after it.
+    ++frame;
+  }
+  const auto& latest = frames_.back().damage;
+  if (!latest.has_value()) {
+    return std::nullopt;
+  }
+  Texture::Damage damage{.frame_size = latest->frame_size, .rect = {}};
+  for (; frame != frames_.end(); ++frame) {
+    if (!frame->damage.has_value() ||
+        frame->damage->frame_size != damage.frame_size) {
+      return std::nullopt;
+    }
+    damage.rect = damage.rect.Union(frame->damage->rect);
+  }
+  return damage;
+}
+
+}  // namespace flutter
