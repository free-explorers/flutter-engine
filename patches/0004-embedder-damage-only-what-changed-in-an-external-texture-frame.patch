+  MockLayerTree tree2;
+  tree2.root()->Add(make_layer());
+  auto damage = DiffLayerTree(tree2, tree1);
+  // One more pixel around the damage for linear sampling: (19, 19, 41, 41),
+  // halved and offset by the layer.
+  EXPECT_EQ(damage.frame_damage, DlIRect::MakeLTRB(19, 19, 31, 31));
