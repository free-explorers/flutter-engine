diff --git a/engine/src/flutter/flow/layers/texture_layer.cc b/engine/src/flutter/flow/layers/texture_layer.cc
index 1d5ee79a96..46bed77e12 100644
--- a/engine/src/flutter/flow/layers/texture_layer.cc
+++ b/engine/src/flutter/flow/layers/texture_layer.cc
@@ -25,12 +25,20 @@ void TextureLayer::Diff(DiffContext* context, const Layer* old_layer) {
     FML_DCHECK(old_layer);
     auto prev = old_layer->as_texture_layer();
     // A texture that identifies its frames is only repainted when it presents
-    // a new one; any other texture may change on every paint.
+    // a new one, and only where that frame changed when the texture knows;
+    // any other texture may change on every paint.
     if (prev->offset_ != offset_ || prev->size_ != size_ ||
         prev->texture_id_ != texture_id_ || prev->freeze_ != freeze_ ||
-        prev->sampling_ != sampling_ ||
-        !context->IsOldLayerTextureFrameCurrent(prev, texture_id_)) {
+        prev->sampling_ != sampling_) {
       context->MarkSubtreeDirty(context->GetOldLayerPaintRegion(prev));
+    } else if (!context->IsOldLayerTextureFrameCurrent(prev, texture_id_)) {
+      auto damage = MapTextureDamage(
+          context->GetOldLayerTextureDamage(prev, texture_id_));
+      if (damage.has_value()) {
+        context->AddLayerDamage(damage.value());
+      } else {
+        context->MarkSubtreeDirty(context->GetOldLayerPaintRegion(prev));
+      }
     }
   }
 
@@ -45,6 +53,40 @@ void TextureLayer::Diff(DiffContext* context, const Layer* old_layer) {
   context->SetLayerTextureFrame(this, texture_id_);
 }
 
+std::optional<DlRect> TextureLayer::MapTextureDamage(
+    const std::optional<Texture::Damage>& damage) const {
+  if (!damage.has_value() || damage->frame_size.IsEmpty()) {
+    return std::nullopt;
+  }
+  if (damage->rect.IsEmpty()) {
+    return DlRect();
+  }
+  // A changed pixel also changes what is sampled around it.
+  int32_t margin;
+  switch (sampling_) {
+    case DlImageSampling::kNearestNeighbor:
+    case DlImageSampling::kLinear:
+      margin = 1;
+      break;
+    case DlImageSampling::kCubic:
+      margin = 2;
+      break;
+    case DlImageSampling::kMipmapLinear:
+      // A mipmap level averages ever larger areas of the texture.
+      return std::nullopt;
+  }
+  auto frame_bounds = DlIRect::MakeSize(damage->frame_size);
+  auto rect =
+      damage->rect.Expand(margin, margin).IntersectionOrEmpty(frame_bounds);
+  // The whole frame is stretched over the layer bounds.
+  DlScalar scale_x = size_.width / damage->frame_size.width;
+  DlScalar scale_y = size_.height / damage->frame_size.height;
+  return DlRect::MakeLTRB(offset_.x + rect.GetLeft() * scale_x,
+                          offset_.y + rect.GetTop() * scale_y,
+                          offset_.x + rect.GetRight() * scale_x,
+                          offset_.y + rect.GetBottom() * scale_y);
+}
+
 void TextureLayer::Preroll(PrerollContext* context) {
   set_paint_bounds(DlRect::MakeOriginSize(offset_, size_));
   context->has_texture_layer = true;
