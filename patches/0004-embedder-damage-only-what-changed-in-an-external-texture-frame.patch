+TEST_F(TextureLayerDiffTest, TextureDamageIsMappedToTheLayer) {
+  auto texture = std::make_shared<MockTexture>(0);
+  texture->IdentifyFrames();
+  texture_registry()->RegisterTexture(texture);
+
+  // A 200x100 frame shown at half its size.
+  auto make_layer = [] {
+    return std::make_shared<TextureLayer>(DlPoint(10, 10), DlSize(100, 50), 0,
+                                          false, DlImageSampling::kLinear);
+  };
+  MockLayerTree tree1;
+  tree1.root()->Add(make_layer());
+  DiffLayerTree(tree1, MockLayerTree());
+
+  texture->MarkNewFrameAvailable();
+  texture->set_damage(Texture::Damage{
+      .frame_size = DlISize(200, 100),
+      .rect = DlIRect::MakeLTRB(20, 20, 40, 40),
