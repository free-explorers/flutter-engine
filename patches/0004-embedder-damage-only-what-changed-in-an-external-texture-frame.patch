@@ -3280,6 +3280,56 @@ FlutterEngineResult FlutterEngineMarkExternalTextureFrameAvailable(
   return kSuccess;
 }
 
+FlutterEngineResult FlutterEngineMarkExternalTextureFrameAvailableWithInfo(
+    FLUTTER_API_SYMBOL(FlutterEngine) engine,
+    int64_t texture_identifier,
+    const FlutterExternalTextureFrameInfo* frame_info) {
+  if (engine == nullptr) {
+    return LOG_EMBEDDER_ERROR(kInvalidArguments, "Invalid engine handle.");
+  }
+  if (texture_identifier == 0) {
+    return LOG_EMBEDDER_ERROR(kInvalidArguments, "Invalid texture identifier.");
+  }
+  if (frame_info == nullptr) {
+    return LOG_EMBEDDER_ERROR(kInvalidArguments, "Invalid frame info.");
+  }
+
+  // Without a size and damage, the whole frame is damaged.
+  std::optional<flutter::Texture::Damage> damage;
+  if (STRUCT_HAS_MEMBER(frame_info, size) &&
+      STRUCT_HAS_MEMBER(frame_info, damage)) {
+    const FlutterUIntSize& size = frame_info->size;
+    const FlutterDamage& frame_damage = frame_info->damage;
+    if (frame_damage.num_rects > 0 && frame_damage.damage == nullptr) {
+      return LOG_EMBEDDER_ERROR(kInvalidArguments,
+                                "Frame damage has rects but no rect array.");
+    }
+    if (size.width > 0 && size.height > 0) {
+      auto frame_bounds = flutter::DlIRect::MakeWH(
+          static_cast<int32_t>(size.width), static_cast<int32_t>(size.height));
+      flutter::DlIRect rect;
+      for (size_t i = 0; i < frame_damage.num_rects; i++) {
+        const FlutterRect& damage_rect = frame_damage.damage[i];
+        rect = rect.Union(flutter::DlIRect::RoundOut(
+            flutter::DlRect::MakeLTRB(damage_rect.left, damage_rect.top,
+                                      damage_rect.right, damage_rect.bottom)));
+      }
+      damage = flutter::Texture::Damage{
+          .frame_size = frame_bounds.GetSize(),
+          .rect = rect.IntersectionOrEmpty(frame_bounds),
+      };
+    }
+  }
+
