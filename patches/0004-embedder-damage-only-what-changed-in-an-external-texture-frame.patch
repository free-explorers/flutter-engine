index 0000000000..a354f44b7b
--- /dev/null
+++ b/engine/src/flutter/shell/platform/embedder/tests/embedder_external_texture_frames_unittests.cc
@@ -0,0 +1,146 @@
+// Copyright 2013 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/shell/platform/embedder/embedder_external_texture_frames.h"
+
+#include "gtest/gtest.h"
+
+namespace flutter {
+namespace testing {
+
+namespace {
+
+Texture::Damage MakeDamage(const DlIRect& rect) {
+  return Texture::Damage{.frame_size = DlISize(100, 100), .rect = rect};
+}
+
+}  // namespace
+
+TEST(EmbedderExternalTextureFramesTest, FramesAreTakenInOrder) {
+  EmbedderExternalTextureFrames frames;
+  frames.Register(1);
+  frames.Register(2);
+  frames.MarkFrameAvailable(1, MakeDamage(DlIRect::MakeLTRB(0, 0, 10, 10)));
+  frames.MarkFrameAvailable(1, std::nullopt);
+  frames.MarkFrameAvailable(1, MakeDamage(DlIRect::MakeLTRB(5, 5, 10, 10)));
+
+  auto damage = frames.TakeFrame(1);
+  ASSERT_TRUE(damage.has_value());
+  EXPECT_EQ(damage->rect, DlIRect::MakeLTRB(0, 0, 10, 10));
+  EXPECT_FALSE(frames.TakeFrame(1).has_value());
+  damage = frames.TakeFrame(1);
+  ASSERT_TRUE(damage.has_value());
+  EXPECT_EQ(damage->rect, DlIRect::MakeLTRB(5, 5, 10, 10));
+  // Nothing left: not known.
+  EXPECT_FALSE(frames.TakeFrame(1).has_value());
+}
+
+TEST(EmbedderExternalTextureFramesTest, FramesArePerTexture) {
+  EmbedderExternalTextureFrames frames;
+  frames.Register(1);
+  frames.Register(2);
+  frames.MarkFrameAvailable(1, MakeDamage(DlIRect::MakeLTRB(0, 0, 10, 10)));
+  frames.MarkFrameAvailable(2, MakeDamage(DlIRect::MakeLTRB(0, 0, 20, 20)));
+
+  auto damage = frames.TakeFrame(2);
+  ASSERT_TRUE(damage.has_value());
+  EXPECT_EQ(damage->rect, DlIRect::MakeLTRB(0, 0, 20, 20));
+  damage = frames.TakeFrame(1);
+  ASSERT_TRUE(damage.has_value());
+  EXPECT_EQ(damage->rect, DlIRect::MakeLTRB(0, 0, 10, 10));
+}
+
+TEST(EmbedderExternalTextureFramesTest, DroppedFramesAreNotKnown) {
+  EmbedderExternalTextureFrames frames;
+  frames.Register(1);
+  frames.Register(2);
+  for (int i = 0; i < 20; i++) {
+    frames.MarkFrameAvailable(1, MakeDamage(DlIRect::MakeLTRB(i, 0, i + 1, 1)));
+  }
+  // The four oldest were dropped, but still pair with their marks.
+  for (int i = 0; i < 4; i++) {
+    EXPECT_FALSE(frames.TakeFrame(1).has_value());
+  }
+  auto damage = frames.TakeFrame(1);
+  ASSERT_TRUE(damage.has_value());
+  EXPECT_EQ(damage->rect, DlIRect::MakeLTRB(4, 0, 5, 1));
+}
+
+TEST(EmbedderExternalTextureFramesTest, ForgottenFramesAreNotKnown) {
+  EmbedderExternalTextureFrames frames;
+  frames.Register(1);
+  frames.Register(2);
+  frames.MarkFrameAvailable(1, MakeDamage(DlIRect::MakeLTRB(0, 0, 10, 10)));
+  frames.Forget(1);
+  EXPECT_FALSE(frames.TakeFrame(1).has_value());
+}
+
+TEST(EmbedderExternalTextureFramesTest, UnregisteredFramesAreNotRecorded) {
+  EmbedderExternalTextureFrames frames;
+  frames.MarkFrameAvailable(3, MakeDamage(DlIRect::MakeLTRB(0, 0, 10, 10)));
+  frames.Register(3);
+  EXPECT_FALSE(frames.TakeFrame(3).has_value());
+}
+
+TEST(EmbedderExternalTextureFramesTest, HistoryUnitesTheDamageSinceAFrame) {
+  EmbedderExternalTextureFrames::History history;
+  auto first = history.frame_id();
+  history.AddFrame(MakeDamage(DlIRect::MakeLTRB(0, 0, 10, 10)));
+  auto second = history.frame_id();
+  EXPECT_NE(first, second);
+  history.AddFrame(MakeDamage(DlIRect::MakeLTRB(20, 20, 30, 30)));
+
+  auto damage = history.DamageSince(first);
+  ASSERT_TRUE(damage.has_value());
+  EXPECT_EQ(damage->frame_size, DlISize(100, 100));
+  EXPECT_EQ(damage->rect, DlIRect::MakeLTRB(0, 0, 30, 30));
+
+  damage = history.DamageSince(second);
+  ASSERT_TRUE(damage.has_value());
+  EXPECT_EQ(damage->rect, DlIRect::MakeLTRB(20, 20, 30, 30));
+
+  damage = history.DamageSince(history.frame_id());
+  ASSERT_TRUE(damage.has_value());
+  EXPECT_TRUE(damage->rect.IsEmpty());
+}
+
+TEST(EmbedderExternalTextureFramesTest, HistoryDoesNotKnowOtherFrames) {
+  EmbedderExternalTextureFrames::History history;
+  EmbedderExternalTextureFrames::History other;
+  history.AddFrame(MakeDamage(DlIRect::MakeLTRB(0, 0, 10, 10)));
+  EXPECT_FALSE(history.DamageSince(other.frame_id()).has_value());
+}
+
+TEST(EmbedderExternalTextureFramesTest, HistoryForgetsOldFrames) {
+  EmbedderExternalTextureFrames::History history;
+  auto first = history.frame_id();
+  for (int i = 0; i < 9; i++) {
+    history.AddFrame(MakeDamage(DlIRect::MakeLTRB(0, 0, 10, 10)));
+  }
+  EXPECT_FALSE(history.DamageSince(first).has_value());
+}
+
+TEST(EmbedderExternalTextureFramesTest, HistoryDoesNotKnowAcrossUnknownDamage) {
+  EmbedderExternalTextureFrames::History history;
+  auto first = history.frame_id();
+  history.AddFrame(std::nullopt);
+  auto second = history.frame_id();
+  history.AddFrame(MakeDamage(DlIRect::MakeLTRB(0, 0, 10, 10)));
+
+  EXPECT_FALSE(history.DamageSince(first).has_value());
+  EXPECT_TRUE(history.DamageSince(second).has_value());
+}
+
+TEST(EmbedderExternalTextureFramesTest, HistoryDoesNotKnowAcrossResize) {
+  EmbedderExternalTextureFrames::History history;
+  auto first = history.frame_id();
+  history.AddFrame(MakeDamage(DlIRect::MakeLTRB(0, 0, 10, 10)));
+  history.AddFrame(Texture::Damage{.frame_size = DlISize(200, 100),
+                                   .rect = DlIRect::MakeLTRB(0, 0, 10, 10)});
+
+  EXPECT_FALSE(history.DamageSince(first).has_value());
+}
+
+}  // namespace testing
+}  // namespace flutter
